{
  "name": "low-efficiency-land-system",
  "version": "0.1.0",
  "private": true,
  "description": "低效用地监管系统：MapLibre + OpenStreetMap 矢量底图",
  "type": "module",
  "scripts": {
    "import": "node server/import.js",
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "build:pages": "node scripts/export-static.js && vite build --config web/vite.config.js --mode pages",
    "preview:pages": "vite preview --config web/vite.config.js --mode pages",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "express": "^5.3.0",
    "maplibre-gl": "^6.17.0",
    "shapefile": "^0.6.6",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "vite": "^8.3.7"
  }
}
